# Server (.env). Never commit real values.
ANTHROPIC_API_KEY=

# Browser (.env.local): Supabase project URL and publishable (anon) key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server overrides (leave commented to reuse the VITE values; an empty value would override them).
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Hosting (Vercel) only.
# DEMO_USER_IDS=
# ANALYSIS_JOB_SIGNING_KEY=
# CRON_SECRET=

# Optional limits.
# MAX_ANALYSIS_REQUESTS=512
# MAX_ANALYSIS_BUDGET_USD=25
# MODEL_TIMEOUT_MS=600000
