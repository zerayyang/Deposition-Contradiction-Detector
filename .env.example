ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Hosting: NODE_ENV=production; persistent private disk required.
# Server accepts Supabase login tokens; publishable key is sufficient, no service key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# ANALYSIS_JOB_DIR=/var/data/deposition-jobs
# PORT=3000
# MAX_ANALYSIS_REQUESTS=12
# MAX_ANALYSIS_BUDGET_USD=25
# MODEL_TIMEOUT_MS=600000

# Production private demo requires allowed Supabase user IDs (comma separated).
# DEMO_USER_IDS=your-own-user-uuid

# Vercel server-only variables (never prefix secrets with VITE_).
# Set these in the Vercel project environment settings; do not commit real values.
SUPABASE_URL=https://your-project.supabase.co
# Reserved server-only admin secret; not used by the current app.
# Existing authentication needs only a publishable key; no admin operations are added.
SUPABASE_SERVICE_ROLE_KEY=
# Also set DEMO_USER_IDS for the production private-demo allowlist.
# On Vercel disk recovery is disabled; ANALYSIS_JOB_DIR is for persistent hosts only.
