{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:deposition:event-records:v1",
  "title": "Source-linked proposed testimony events, version 1",
  "description": "Extraction records only. Structural/source validation does not establish truth, semantic accuracy, complete recall or numeric confidence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "documentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/event"
      }
    },
    "coverage": {
      "$ref": "#/definitions/coverage"
    }
  },
  "required": [
    "schemaVersion",
    "documentId",
    "documentSha256",
    "events",
    "coverage"
  ],
  "definitions": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdfPage": {
          "type": "integer",
          "minimum": 1
        },
        "pageLabel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pdfPage",
        "pageLabel"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "WITNESS",
            "QUESTION"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "pageRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/page"
          }
        }
      },
      "required": [
        "id",
        "role",
        "quote",
        "start",
        "end",
        "pageRefs"
      ]
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "STATED",
            "UNSTATED",
            "AMBIGUOUS"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "basis": {
          "enum": [
            "WITNESS_WORDS",
            "QUESTION_CONTEXT",
            "NONE"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "state",
        "value",
        "basis",
        "sourceIds"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polarity": {
          "enum": [
            "AFFIRMED",
            "DENIED",
            "UNCERTAIN",
            "UNKNOWN"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "polarity",
        "sourceIds"
      ]
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "ASSERTION",
            "VALUE",
            "UNRESOLVED"
          ]
        },
        "attributeNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "phrase",
        "sourceId",
        "scope",
        "attributeNames"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CORRECTS",
            "QUALIFIES",
            "REPORTS"
          ]
        },
        "targetEventId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "targetEventId",
        "explanation"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "$ref": "#/definitions/assertion"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attribute"
          }
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/qualifier"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relation"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          },
          "minItems": 1
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "unresolvedReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "kind",
        "summary",
        "assertion",
        "attributes",
        "qualifiers",
        "relations",
        "sources",
        "reviewRequired",
        "unresolvedReasons"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "PROCESSED",
            "UNPROCESSED",
            "FAILED"
          ]
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "status",
        "eventIds",
        "reason"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "FAILED"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/segment"
          },
          "minItems": 1
        }
      },
      "required": [
        "status",
        "segments"
      ]
    }
  }
}
